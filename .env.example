# Copy to .env.local (gitignored) and fill in; set the same three in Vercel's project env vars.
ODOO_URL=https://jump-tiring-defection.ngrok-free.dev
ODOO_DB=odoo-e
# = Odoo System Parameter harleys_planner.portal_token
HARLEYS_PORTAL_TOKEN=
# Odoo the GRN web app (/app) is forwarded to; default https://harleys.odoo.com
GRN_ODOO_URL=
# Hygiene Audit dashboard (/audit). Sheet must be link-shared for the pull fallback.
AUDIT_SHEET_ID=
# Same value as the Apps Script property WEBHOOK_SECRET (menu Audit Dashboard → Connect dashboard)
AUDIT_WEBHOOK_SECRET=
# How often the sheet is re-read while someone has /audit open (seconds, min 10). The safety net for
# edits the trigger did not push.
AUDIT_POLL_SECONDS=30
# Shared store for the dashboard's data. On Vercel: add the Upstash Redis integration (Vercel →
# Storage / Marketplace → Upstash → connect to this project); it sets these two for you.
# Leave empty locally to use the file store .data/audit-<sheet id>.json (or set AUDIT_STORE_FILE).
KV_REST_API_URL=
KV_REST_API_TOKEN=
