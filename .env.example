# Copy to .env.local (gitignored) and fill in; set the same three in Vercel's project env vars.
ODOO_URL=https://jump-tiring-defection.ngrok-free.dev
ODOO_DB=odoo-e
# = Odoo System Parameter harleys_planner.portal_token
HARLEYS_PORTAL_TOKEN=
# Odoo the GRN web app (/app) is forwarded to; default https://harleys.odoo.com
GRN_ODOO_URL=
# Customers' ordering page /order (Odoo module harleys_custom). Empty URL = sample data.
CUSTOM_ODOO_URL=
CUSTOM_ODOO_DB=
# = Odoo System Parameter harleys_custom.portal_token
CUSTOM_PORTAL_TOKEN=
# Google reCAPTCHA v2 Checkbox (free) on the order lookup /order/track. Empty = no check (local testing).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
